/* Hyggshi OS - Dark theme for LXQt notifications */
Notification {
    color: #dcdee4;
    border: 1px solid rgba(255, 255, 255, 14%);
    background: rgba(34, 36, 43, 97%);
    margin: 0px;
}

QLabel {
    color: #eceef2;
}

#closeButton {
    border: none;
    padding: 2px;
    qproperty-icon: url(lxqt-notificationd/cancel.svg);
}

#closeButton:hover {
    border: 1px solid rgba(255, 255, 255, 14%);
    padding: 2px;
    background: rgba(255, 255, 255, 11%);
    qproperty-icon: url(lxqt-notificationd/cancel.svg);
}

#appLabel {
    font-weight: bold;
}
