/*
 * Hyggshi OS - Dark theme for LXQt panel
 * Soft palette: no pure black / pure white, muted accent.
 */

LXQtPanel #BackgroundWidget {
    background: rgba(28, 30, 36, 90%);
}
QToolTip {
    border: 1px solid #3b3e49;
    background: #2b2e37;
    color: #dcdee4;
    padding: 2px 4px;
    margin: 0px;
}

/* General plugins */
Plugin,
LXQtPanelPlugin {
    padding: 0;
    spacing: 20px;
    qproperty-moveMarkerColor: #d0656b;
}

Plugin  > QWidget,
Plugin  > QWidget > QWidget {
    color: #dcdee4;
}

Plugin > QToolButton,
Plugin > QWidget > QToolButton,
Plugin > QWidget > QToolButton > QWidget > QToolButton,
LXQtPanelPlugin > QToolButton {
    margin: 0;
    border: 1px solid transparent;
    qproperty-iconSize: 24px;
    color: #dcdee4;
}

Plugin > QToolButton:hover,
Plugin > QWidget > QToolButton:hover,
LXQtPanelPlugin > QToolButton:hover {
    background: rgba(255, 255, 255, 11%);
}

Plugin > QToolButton:pressed,
Plugin > QWidget > QToolButton:pressed,
LXQtPanelPlugin > QToolButton:pressed {
    padding: 4px;
}

/* Volume plugin */
VolumePopup {
    background: #2b2e37;
    border: 1px solid rgba(255, 255, 255, 12%);
    margin: 2px;
}

VolumePopup  > QPushButton {
    border: 1px solid rgba(255, 255, 255, 12%);
    border-radius: 3px;
    color: #dcdee4;
    background: rgba(255, 255, 255, 11%);
    padding: 2px 10px;
    margin: 3px;
    qproperty-iconSize: 24px;
}

VolumePopup  > QPushButton:hover {
    border: 1px solid rgba(255, 255, 255, 14%);
    border-radius: 3px;
    background: rgba(255, 255, 255, 18%);
}

VolumePopup  > QSlider::groove:vertical {
    background: #3b3e49;
    width: 8px;
    border-radius: 4px;
}

VolumePopup  > QSlider::handle:vertical {
    height: 10px;
    background: #dcdee4;
    border-radius: 5px;
    margin: 0 -4px;
}

VolumePopup  > QSlider::add-page:vertical {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #6f7586, stop: 1 #9ea4b4);
    border: 1px solid rgba(255, 255, 255, 12%);
    border-radius: 4px;
}

VolumePopup  > QSlider::sub-page:vertical {
    background: #1b1d23;
    border-radius: 4px;
}

/* Desktop switch */
#DesktopSwitch QToolButton:hover {
    border: 1px solid rgba(255, 255, 255, 14%);
    background: rgba(255, 255, 255, 11%);
}

#DesktopSwitch QToolButton:on {
    background: #9a3b41;
    border: 1px solid #9a3b41;
    color: #ffffff;
    font: bold;
}

#DesktopSwitch QToolButton:hover:on {
    background: #ad464d;
    border: 1px solid #ad464d;
}

#DesktopSwitch QToolButton:pressed {
    background: #7f2f35;
    padding: 4px;
}

#DesktopSwitch QToolButton[urgent="true"] {
    color: #ffffff;
    background: #b8434a;
    border: 1px solid #d96b72;
}

/* QuickLaunch */
#QuickLaunchPlaceHolder {
    color: #9a9fae;
}

#QuickLaunch QToolButton{
    border: 0px;
    margin: 1px;
    padding: 2px;
}

#QuickLaunch QToolButton:hover{
    border: 1px solid rgba(255, 255, 255, 14%);
    background: rgba(255, 255, 255, 11%);
}

#QuickLaunch QToolButton:pressed {
    padding: 4px;
}

/* TaskBar */
#TaskBar QToolButton{
    margin: 2px;
    padding: 2px;
}

#TaskBar QToolButton:on{
    border-top: 3px solid #d0656b;
    background: rgba(255, 255, 255, 9%);
}

#TaskBar QToolButton:hover{
    border-left: 1px solid rgba(255, 255, 255, 14%);
    border-right: 1px solid rgba(255, 255, 255, 14%);
    border-bottom: 1px solid rgba(255, 255, 255, 14%);
    background: rgba(255, 255, 255, 11%);
}

#TaskBar QToolButton:pressed {
    padding: 4px;
}

#TaskBar QToolButton[urgent="true"] {
    color: palette(highlighted-text);
    background: palette(highlight);
}

#TaskBar LXQtGroupPopup {
    background: rgba(34, 36, 43, 94%);
    border: 1px solid rgba(255, 255, 255, 12%);
}

/* Calendar widget */
QCalendarWidget QAbstractItemView:enabled {
    color: #eceef2;
    background: #202329;
    selection-background-color: #9a3b41;
    selection-color: #ffffff;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #6c7181;
}

QCalendarWidget QWidget {
    alternate-background-color: #2a2d36;
}

QCalendarWidget #qt_calendar_navigationbar,
QCalendarWidget #qt_calendar_navigationbar * {
    background-color: #2b2e37;
    color: #dcdee4;
}
QCalendarWidget #qt_calendar_monthbutton {
    padding: 2px;
    margin: 2px;
}
QCalendarWidget #qt_calendar_monthbutton:hover {
    border: 1px solid rgba(255, 255, 255, 14%);
    background: rgba(255, 255, 255, 11%);
}

QCalendarWidget #qt_calendar_monthbutton::menu-indicator {
    image: none;
}

QCalendarWidget QTableView {
    selection-background-color: #9a3b41;
}
QCalendarWidget #qt_calendar_nextmonth {
    max-height: 20px;
    min-height: 20px;
    qproperty-icon: url(calendar-popup/right-arrow.svg);
}
QCalendarWidget #qt_calendar_prevmonth {
    max-height: 20px;
    min-height: 20px;
    qproperty-icon: url(calendar-popup/left-arrow.svg);
}

/* Clock */
#Clock:hover {
    border: 1px solid rgba(255, 255, 255, 14%);
    background: rgba(255, 255, 255, 11%);
}

#Clock > QWidget{
    margin: 2px;
}
#Clock #TimeLabel{
    color: #dcdee4;
    margin-right: 2px;
    margin-left: 2px;
}
#Clock #DateLabel{
    color: #dcdee4;
    margin-right: 2px;
    margin-left: 2px;
}

/* Tray */
#Tray {
    min-width: 6px;
    padding-left: 2px;
    padding-right: 2px;
}

TrayIcon {
    margin: 2px;
}

/* All menus */
QMenu {
    margin: 0px;
    padding: 3px;
    border: 1px solid rgba(255, 255, 255, 14%);
    background: rgba(34, 36, 43, 97%);
    color: #eceef2;
}

QMenu::icon {
    background-color: transparent;
    border: 20px;
}

QMenu QToolButton {
    background-color: #2a2d36;
    padding: 5px;
    border: none;
    color: #eceef2;
    font: bold italic;
}

QMenu::separator {
    background-color: transparent;
}

QMenu::item {
    border: 10px solid transparent;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 5px;
    padding: 6px 40px 6px 24px;
    background: transparent;
    color: #eceef2;
}

QMenu::item:selected {
    border: 10px solid #9a3b41;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 5px;
    background: #9a3b41;
    color: #ffffff;
}

QMenu::item:selected:disabled {
    background-color: palette(text);
}

QMenu::item:disabled {
    color: #6c7181;
    background-color: transparent;
}

QMenu::right-arrow {
    image: url(arrow-right.svg);
}

QMenu::indicator {
    width: 13px;
    height: 13px;
}

QMenu::indicator:non-exclusive:unchecked {
    image: url(unchecked.svg);
}

QMenu::indicator:non-exclusive:checked {
    image: url(checked.svg);
}

/* Main menu */
#MainMenu {
    margin: 2px;
    padding: 3px;
    border: none;
    background: rgba(34, 36, 43, 97%);
    qproperty-icon: url(mainmenu.svg);
    color: #eceef2;
}

#MainMenu QLineEdit {
    background: #1b1d23;
    border: 1px solid #3b3e49;
    border-radius: 3px;
    padding: 4px;
    margin-bottom: 2px;
    color: #eceef2;
    selection-background-color: #9a3b41;
    selection-color: #ffffff;
}

#MainMenu ActionView {
    border: none;
    background: rgba(34, 36, 43, 97%);
    color: #eceef2;
}

#MainMenu ActionView::item {
    background: transparent;
    color: #eceef2;
    border: none;
    padding: 4px 3px 4px 10px;
}

#MainMenu ActionView::item:selected {
    background: #9a3b41;
    color: #ffffff;
}

#MainMenu ActionView::item:hover {
    background: rgba(255, 255, 255, 11%);
    color: #eceef2;
}

/* Mount plugin */
#LXQtMountPlugin {
    margin: 2px;
}

#LXQtMountPopup {
    background-color: #2b2e37;
    padding: 4px;
}

#LXQtMountPopup > MenuDiskItem {
    border-radius: 4px;
}

#LXQtMountPopup > MenuDiskItem:hover {
    border: 1px solid rgba(255, 255, 255, 14%);
    background: rgba(255, 255, 255, 11%);
}

#LXQtMountPopup #EjectButton,
#LXQtMountPopup #DiskButton {
    qproperty-iconSize: 22px;
    background-color: transparent;
    border: none;
    color: #dcdee4;
    padding: 4px;
}

#LXQtMountPopup #NoDiskLabel {
    margin: 6px;
    color: #9a9fae;
}

/* ShowDesktop */
#ShowDesktop > QToolButton:hover {
    border: 1px solid rgba(255, 255, 255, 14%);
    background: rgba(255, 255, 255, 11%);
}

/* KbIndicator */
#KbIndicator > QLabel {
    padding: 3px;
    border: 0px;
    font: bold;
}

#KbIndicator > QLabel:disabled {
    color: #9a9fae;
}

#KbIndicator > QLabel:enabled {
    color: #ffffff;
    background: #9a3b41;
}

/* SysStat */
#SysStat {
    padding: 2px 2px 2px 2px;
    margin: 2px;
}

#SysStat > QLabel {
    font-size: 6pt;
}

#SysStat_Graph {
    qproperty-gridColor: rgba(255, 255, 255, 20%);
    qproperty-titleColor: rgba(255, 255, 255, 75%);
    qproperty-cpuSystemColor: rgb(217, 107, 114);
    qproperty-cpuUserColor: rgb(110, 160, 230);
    qproperty-cpuNiceColor: rgb(120, 200, 140);
    qproperty-cpuOtherColor: rgb(220, 190, 110);
    qproperty-frequencyColor: rgb(150, 155, 170);
    qproperty-memAppsColor: rgb(110, 160, 230);
    qproperty-memBuffersColor: rgb(120, 200, 140);
    qproperty-memCachedColor: rgb(220, 190, 110);
    qproperty-swapUsedColor: rgb(217, 107, 114);
    qproperty-netReceivedColor: rgb(110, 160, 230);
    qproperty-netTransmittedColor: rgb(220, 190, 110);
}

/* WorldClock */
#WorldClock:hover {
    border: 1px solid rgba(255, 255, 255, 14%);
    background: rgba(255, 255, 255, 11%);
}

#WorldClockContent {
    margin-right: 2px;
    margin-left: 2px;
    padding: 2px;
    color: #dcdee4;
    background: transparent;
}

/* CPU monitor */
#LXQtCpuLoad {
    qproperty-fontColor: #dcdee4;
}

/* Spacer */
#Spacer {
    background-position: center center;
}

#Spacer[type="lined"] {
    background-image: url(/spacer-plugin/spacer-line.svg);
}

#Spacer[type="dotted"] {
    background-image: url(/spacer-plugin/spacer-dots.svg);
}

#Spacer[orientation="horizontal"] {
    background-repeat: repeat-y;
    margin-top: 2px;
    margin-bottom: 2px;
}

#Spacer[orientation="vertical"] {
    background-repeat: repeat-x;
    margin-right: 2px;
    margin-left: 2px;
}

/* Color Picker */
#ColorPickerPlugin QToolButton{
    qproperty-icon: url(/color-picker.svg);
    margin: 0px;
    padding: 2px;
    background: rgba(0, 0, 0, 30%);
}

#ColorPickerPlugin QToolButton:pressed {
    padding: 4px;
    background: #9a3b41;
}

#ColorPickerPlugin QLineEdit {
    border: none;
    margin: 0px;
    padding: 0px;
    background: rgba(0, 0, 0, 30%);
    color: #dcdee4;
}
