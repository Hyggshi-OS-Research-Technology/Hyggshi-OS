/*
 * Hyggshi OS - Light theme for LXQt runner
 */

#panel {
    background: rgba(248, 246, 242, 98%);
    border: 1px solid rgba(0, 0, 0, 18%);
}

QToolButton::menu-indicator {
    image: none;
}

#closeButton {
    qproperty-icon: url(lxqt-runner/close.svg);
    margin: 2px;
}
#closeButton:hover {
    border: 1px solid rgba(0, 0, 0, 12%);
    background: rgba(0, 0, 0, 8%);
}

#actionButton {
    qproperty-icon: url(lxqt-runner/down-arrow.svg);
    color: rgba(41, 41, 41, 0%);
    margin: 2px;
}
#actionButton:hover {
    border: 1px solid rgba(0, 0, 0, 12%);
    background: rgba(0, 0, 0, 8%);
}
#actionButton:pressed {
    border: 1px solid rgba(0, 0, 0, 12%);
    background: rgba(0, 0, 0, 14%);
}

QLineEdit {
    background: #fdfcfa;
    border: 1px solid #cdcac2;
    border-radius: 3px;
    padding: 6px;
    margin-bottom: 1px;
    color: #1f2127;
    selection-background-color: #b64a50;
    selection-color: #ffffff;
}

#commandList {
    border: none;
}

QMenu {
    margin: 0px;
    padding: 3px;
    border: 1px solid rgba(0, 0, 0, 18%);
    background: rgba(248, 246, 242, 98%);
    color: #1f2127;
}

QMenu::icon {
    background-color: transparent;
    border: 20px;
}

QMenu QToolButton {
    background-color: #efece6;
    padding: 5px;
    border: none;
    color: #1f2127;
    font: bold italic;
}

QMenu::item {
    border: 10px solid transparent;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 5px;
    padding: 6px 40px 6px 24px;
    background: transparent;
    color: #1f2127;
}

QMenu::item:selected {
    border: 10px solid #b64a50;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 5px;
    background: #b64a50;
    color: #ffffff;
}

QMenu::item:selected:disabled {
    background-color: palette(text);
}

QMenu::item:disabled {
    color: #a0a4af;
}

QMenu::right-arrow {
    image: url(arrow-right.svg);
}

QMenu::indicator {
    width: 13px;
    height: 13px;
}

QMenu::indicator:non-exclusive:unchecked {
    image: url(unchecked.svg);
}

QMenu::indicator:non-exclusive:checked {
    image: url(checked.svg);
}
