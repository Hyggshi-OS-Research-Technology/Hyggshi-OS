/*
 * Hyggshi OS - Light theme for LXQt panel
 * Soft palette: no pure black / pure white, muted accent.
 */

LXQtPanel #BackgroundWidget {
    background: rgba(238, 236, 231, 93%);
}
QToolTip {
    border: 1px solid #cdcac2;
    background: #f7f5f1;
    color: #2c2e35;
    padding: 2px 4px;
    margin: 0px;
}

/* General plugins */
Plugin,
LXQtPanelPlugin {
    padding: 0;
    spacing: 20px;
    qproperty-moveMarkerColor: #b64a50;
}

Plugin  > QWidget,
Plugin  > QWidget > QWidget {
    color: #2c2e35;
}

Plugin > QToolButton,
Plugin > QWidget > QToolButton,
Plugin > QWidget > QToolButton > QWidget > QToolButton,
LXQtPanelPlugin > QToolButton {
    margin: 0;
    border: 1px solid transparent;
    qproperty-iconSize: 24px;
    color: #2c2e35;
}

Plugin > QToolButton:hover,
Plugin > QWidget > QToolButton:hover,
LXQtPanelPlugin > QToolButton:hover {
    background: rgba(0, 0, 0, 8%);
}

Plugin > QToolButton:pressed,
Plugin > QWidget > QToolButton:pressed,
LXQtPanelPlugin > QToolButton:pressed {
    padding: 4px;
}

/* Volume plugin */
VolumePopup {
    background: #f7f5f1;
    border: 1px solid rgba(0, 0, 0, 16%);
    margin: 2px;
}

VolumePopup  > QPushButton {
    border: 1px solid rgba(0, 0, 0, 16%);
    border-radius: 3px;
    color: #2c2e35;
    background: rgba(0, 0, 0, 8%);
    padding: 2px 10px;
    margin: 3px;
    qproperty-iconSize: 24px;
}

VolumePopup  > QPushButton:hover {
    border: 1px solid rgba(0, 0, 0, 12%);
    border-radius: 3px;
    background: rgba(0, 0, 0, 14%);
}

VolumePopup  > QSlider::groove:vertical {
    background: #d3d0c8;
    width: 8px;
    border-radius: 4px;
}

VolumePopup  > QSlider::handle:vertical {
    height: 10px;
    background: #2c2e35;
    border-radius: 5px;
    margin: 0 -4px;
}

VolumePopup  > QSlider::add-page:vertical {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #a9adba, stop: 1 #7f8494);
    border: 1px solid rgba(0, 0, 0, 16%);
    border-radius: 4px;
}

VolumePopup  > QSlider::sub-page:vertical {
    background: #c2bfb7;
    border-radius: 4px;
}

/* Desktop switch */
#DesktopSwitch QToolButton:hover {
    border: 1px solid rgba(0, 0, 0, 12%);
    background: rgba(0, 0, 0, 8%);
}

#DesktopSwitch QToolButton:on {
    background: #b64a50;
    border: 1px solid #b64a50;
    color: #ffffff;
    font: bold;
}

#DesktopSwitch QToolButton:hover:on {
    background: #a5414a;
    border: 1px solid #a5414a;
}

#DesktopSwitch QToolButton:pressed {
    background: #8c343b;
    padding: 4px;
}

#DesktopSwitch QToolButton[urgent="true"] {
    color: #ffffff;
    background: #c4474e;
    border: 1px solid #a63a41;
}

/* QuickLaunch */
#QuickLaunchPlaceHolder {
    color: #62677a;
}

#QuickLaunch QToolButton{
    border: 0px;
    margin: 1px;
    padding: 2px;
}

#QuickLaunch QToolButton:hover{
    border: 1px solid rgba(0, 0, 0, 12%);
    background: rgba(0, 0, 0, 8%);
}

#QuickLaunch QToolButton:pressed {
    padding: 4px;
}

/* TaskBar */
#TaskBar QToolButton{
    margin: 2px;
    padding: 2px;
}

#TaskBar QToolButton:on{
    border-top: 3px solid #b64a50;
    background: rgba(0, 0, 0, 8%);
}

#TaskBar QToolButton:hover{
    border-left: 1px solid rgba(0, 0, 0, 12%);
    border-right: 1px solid rgba(0, 0, 0, 12%);
    border-bottom: 1px solid rgba(0, 0, 0, 12%);
    background: rgba(0, 0, 0, 8%);
}

#TaskBar QToolButton:pressed {
    padding: 4px;
}

#TaskBar QToolButton[urgent="true"] {
    color: palette(highlighted-text);
    background: palette(highlight);
}

#TaskBar LXQtGroupPopup {
    background: rgba(248, 246, 242, 96%);
    border: 1px solid rgba(0, 0, 0, 16%);
}

/* Calendar widget */
QCalendarWidget QAbstractItemView:enabled {
    color: #1f2127;
    background: #fdfcfa;
    selection-background-color: #b64a50;
    selection-color: #ffffff;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #a0a4af;
}

QCalendarWidget QWidget {
    alternate-background-color: #efece6;
}

QCalendarWidget #qt_calendar_navigationbar,
QCalendarWidget #qt_calendar_navigationbar * {
    background-color: #e9e6df;
    color: #2c2e35;
}
QCalendarWidget #qt_calendar_monthbutton {
    padding: 2px;
    margin: 2px;
}
QCalendarWidget #qt_calendar_monthbutton:hover {
    border: 1px solid rgba(0, 0, 0, 12%);
    background: rgba(0, 0, 0, 8%);
}

QCalendarWidget #qt_calendar_monthbutton::menu-indicator {
    image: none;
}

QCalendarWidget QTableView {
    selection-background-color: #b64a50;
}
QCalendarWidget #qt_calendar_nextmonth {
    max-height: 20px;
    min-height: 20px;
    qproperty-icon: url(calendar-popup/right-arrow.svg);
}
QCalendarWidget #qt_calendar_prevmonth {
    max-height: 20px;
    min-height: 20px;
    qproperty-icon: url(calendar-popup/left-arrow.svg);
}

/* Clock */
#Clock:hover {
    border: 1px solid rgba(0, 0, 0, 12%);
    background: rgba(0, 0, 0, 8%);
}

#Clock > QWidget{
    margin: 2px;
}
#Clock #TimeLabel{
    color: #2c2e35;
    margin-right: 2px;
    margin-left: 2px;
}
#Clock #DateLabel{
    color: #2c2e35;
    margin-right: 2px;
    margin-left: 2px;
}

/* Tray */
#Tray {
    min-width: 6px;
    padding-left: 2px;
    padding-right: 2px;
}

TrayIcon {
    margin: 2px;
}

/* All menus */
QMenu {
    margin: 0px;
    padding: 3px;
    border: 1px solid rgba(0, 0, 0, 18%);
    background: rgba(248, 246, 242, 98%);
    color: #1f2127;
}

QMenu::icon {
    background-color: transparent;
    border: 20px;
}

QMenu QToolButton {
    background-color: #efece6;
    padding: 5px;
    border: none;
    color: #1f2127;
    font: bold italic;
}

QMenu::separator {
    background-color: transparent;
}

QMenu::item {
    border: 10px solid transparent;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 5px;
    padding: 6px 40px 6px 24px;
    background: transparent;
    color: #1f2127;
}

QMenu::item:selected {
    border: 10px solid #b64a50;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 5px;
    background: #b64a50;
    color: #ffffff;
}

QMenu::item:selected:disabled {
    background-color: palette(text);
}

QMenu::item:disabled {
    color: #a0a4af;
    background-color: transparent;
}

QMenu::right-arrow {
    image: url(arrow-right.svg);
}

QMenu::indicator {
    width: 13px;
    height: 13px;
}

QMenu::indicator:non-exclusive:unchecked {
    image: url(unchecked.svg);
}

QMenu::indicator:non-exclusive:checked {
    image: url(checked.svg);
}

/* Main menu */
#MainMenu {
    margin: 2px;
    padding: 3px;
    border: none;
    background: rgba(248, 246, 242, 98%);
    qproperty-icon: url(mainmenu.svg);
    color: #1f2127;
}

#MainMenu QLineEdit {
    background: #fdfcfa;
    border: 1px solid #cdcac2;
    border-radius: 3px;
    padding: 4px;
    margin-bottom: 2px;
    color: #1f2127;
    selection-background-color: #b64a50;
    selection-color: #ffffff;
}

#MainMenu ActionView {
    border: none;
    background: rgba(248, 246, 242, 98%);
    color: #1f2127;
}

#MainMenu ActionView::item {
    background: transparent;
    color: #1f2127;
    border: none;
    padding: 4px 3px 4px 10px;
}

#MainMenu ActionView::item:selected {
    background: #b64a50;
    color: #ffffff;
}

#MainMenu ActionView::item:hover {
    background: rgba(0, 0, 0, 8%);
    color: #1f2127;
}

/* Mount plugin */
#LXQtMountPlugin {
    margin: 2px;
}

#LXQtMountPopup {
    background-color: #f7f5f1;
    padding: 4px;
}

#LXQtMountPopup > MenuDiskItem {
    border-radius: 4px;
}

#LXQtMountPopup > MenuDiskItem:hover {
    border: 1px solid rgba(0, 0, 0, 12%);
    background: rgba(0, 0, 0, 8%);
}

#LXQtMountPopup #EjectButton,
#LXQtMountPopup #DiskButton {
    qproperty-iconSize: 22px;
    background-color: transparent;
    border: none;
    color: #2c2e35;
    padding: 4px;
}

#LXQtMountPopup #NoDiskLabel {
    margin: 6px;
    color: #62677a;
}

/* ShowDesktop */
#ShowDesktop > QToolButton:hover {
    border: 1px solid rgba(0, 0, 0, 12%);
    background: rgba(0, 0, 0, 8%);
}

/* KbIndicator */
#KbIndicator > QLabel {
    padding: 3px;
    border: 0px;
    font: bold;
}

#KbIndicator > QLabel:disabled {
    color: #62677a;
}

#KbIndicator > QLabel:enabled {
    color: #ffffff;
    background: #b64a50;
}

/* SysStat */
#SysStat {
    padding: 2px 2px 2px 2px;
    margin: 2px;
}

#SysStat > QLabel {
    font-size: 6pt;
}

#SysStat_Graph {
    qproperty-gridColor: rgba(0, 0, 0, 18%);
    qproperty-titleColor: rgba(0, 0, 0, 70%);
    qproperty-cpuSystemColor: rgb(184, 68, 76);
    qproperty-cpuUserColor: rgb(50, 100, 175);
    qproperty-cpuNiceColor: rgb(50, 140, 80);
    qproperty-cpuOtherColor: rgb(170, 130, 30);
    qproperty-frequencyColor: rgb(110, 115, 130);
    qproperty-memAppsColor: rgb(50, 100, 175);
    qproperty-memBuffersColor: rgb(50, 140, 80);
    qproperty-memCachedColor: rgb(170, 130, 30);
    qproperty-swapUsedColor: rgb(184, 68, 76);
    qproperty-netReceivedColor: rgb(50, 100, 175);
    qproperty-netTransmittedColor: rgb(170, 130, 30);
}

/* WorldClock */
#WorldClock:hover {
    border: 1px solid rgba(0, 0, 0, 12%);
    background: rgba(0, 0, 0, 8%);
}

#WorldClockContent {
    margin-right: 2px;
    margin-left: 2px;
    padding: 2px;
    color: #2c2e35;
    background: transparent;
}

/* CPU monitor */
#LXQtCpuLoad {
    qproperty-fontColor: #2c2e35;
}

/* Spacer */
#Spacer {
    background-position: center center;
}

#Spacer[type="lined"] {
    background-image: url(/spacer-plugin/spacer-line.svg);
}

#Spacer[type="dotted"] {
    background-image: url(/spacer-plugin/spacer-dots.svg);
}

#Spacer[orientation="horizontal"] {
    background-repeat: repeat-y;
    margin-top: 2px;
    margin-bottom: 2px;
}

#Spacer[orientation="vertical"] {
    background-repeat: repeat-x;
    margin-right: 2px;
    margin-left: 2px;
}

/* Color Picker */
#ColorPickerPlugin QToolButton{
    qproperty-icon: url(/color-picker.svg);
    margin: 0px;
    padding: 2px;
    background: rgba(255, 255, 255, 45%);
}

#ColorPickerPlugin QToolButton:pressed {
    padding: 4px;
    background: #b64a50;
}

#ColorPickerPlugin QLineEdit {
    border: none;
    margin: 0px;
    padding: 0px;
    background: rgba(255, 255, 255, 45%);
    color: #2c2e35;
}
