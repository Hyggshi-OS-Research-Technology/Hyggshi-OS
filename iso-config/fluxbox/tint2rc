# Tint2 configuration for Hyggshi OS Flex Edition (Slax-style)
# Backgrounds
# 1: Panel background
rounded = 0
border_width = 1
border_sides = T
border_color = #414868 100
background_color = #1a1b26 95

# 2: Default task background
rounded = 4
border_width = 1
border_sides = B
border_color = #414868 60
background_color = #24283b 70

# 3: Active task background
rounded = 4
border_width = 2
border_sides = B
border_color = #7aa2f7 100
background_color = #2e3440 90

# 4: Urgent task background
rounded = 4
border_width = 1
border_sides = B
border_color = #f7768e 100
background_color = #f7768e 40

# 5: Tooltip / Hover task
rounded = 4
border_width = 1
border_sides = B
border_color = #7aa2f7 80
background_color = #3b4261 80

# Panel
panel_items = LTSBC
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 6 2 4
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_dock = 0
primary_monitor_first = 1
autohide = 0
autohide_show_timeout = 0
autohide_hide_timeout = 0
autohide_height = 1
strut_policy = follow_size

# Taskbar
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 4 0 4
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_always_show_all_desktop_tasks = 0
taskbar_sort_order = none

# Tasks
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 180 30
task_padding = 6 3 4
task_font = Sans 9
task_tooltip = 1
task_thumbnail = 0
task_font_color = #a9b1d6 100
task_active_font_color = #c0caf5 100
task_urgent_font_color = #f7768e 100
task_iconified_font_color = #565f89 100
task_icon_asb = 100 0 0
task_active_icon_asb = 100 0 0
task_urgent_icon_asb = 100 0 0
task_iconified_icon_asb = 70 0 0
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 4
task_iconified_background_id = 2

# Mouse actions on tasks
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = toggle
mouse_scroll_up = prev_task
mouse_scroll_down = next_task

# Systray
systray_padding = 6 2 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 20
systray_icon_asb = 100 0 0
systray_monitor = 1
systray_name_filter = 

# Launcher
launcher_padding = 4 2 6
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 22
launcher_icon_asb = 100 0 0
launcher_icon_theme_override = 0
startup_notifications = 0
launcher_tooltip = 1
launcher_item_app = /usr/share/applications/hyggshi-rofi.desktop
launcher_item_app = /usr/share/applications/xterm.desktop
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/calamares.desktop

# Clock
time1_format = %H:%M
time2_format = %d/%m/%Y
time1_font = Sans Bold 9
time2_font = Sans 7
clock_font_color = #c0caf5 100
clock_padding = 8 2
clock_background_id = 0
clock_tooltip = %A, %d %B %Y
clock_tooltip_timezone = 
clock_lclick_command = 
clock_rclick_command = 

# Battery
battery_tooltip = 1
battery_low_status = 20
battery_low_cmd = notify-send "Battery Low"
battery_full_cmd = 
bat1_font = Sans 8
bat2_font = Sans 7
battery_font_color = #c0caf5 100
battery_padding = 4 2
battery_background_id = 0
battery_hide = 101
battery_lclick_command = 
battery_rclick_command = 

# Tooltips
tooltip_show_timeout = 0.5
tooltip_hide_timeout = 0.1
tooltip_padding = 4 4
tooltip_background_id = 5
tooltip_font_color = #c0caf5 100
tooltip_font = Sans 8
